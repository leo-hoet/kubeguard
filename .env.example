# KubeGuard Configuration Template
# Copy to .env for local development ONLY. In production (Cloud Run / GKE),
# inject secrets via Google Cloud Secret Manager (KUBEGUARD_SECRET_PROJECT_ID).

# Runtime environment: "development" | "test" | "production"
KUBEGUARD_ENV=development

# Google Cloud Project (enables Secret Manager, Cloud DLP, Cloud Trace when set)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Secret Manager secret resource names (used when GOOGLE_CLOUD_PROJECT is set)
GEMINI_API_KEY_SECRET_ID=kubeguard-gemini-api-key
API_AUTH_TOKEN_SECRET_ID=kubeguard-api-auth-token
DATABASE_DSN_SECRET_ID=kubeguard-database-dsn

# Local development overrides (never hardcode values in source code)
GOOGLE_API_KEY=
KUBEGUARD_API_TOKEN=

# Model routing configuration (current Gemini 4 / Gemini 3.8 generation)
# Fast tier options: gemini-4-hydrogen | gemini-3.8-flash | gemini-3.5-flash-lite
# Reasoning tier options: gemini-4-neon | gemini-3.1-pro-preview | gemini-4-carbon
KUBEGUARD_FAST_MODEL=gemini-4-hydrogen
KUBEGUARD_REASONING_MODEL=gemini-4-neon

# Cluster backend mode: "simulated" (default, deterministic incidents) | "live" (uses KUBECONFIG / in-cluster)
KUBEGUARD_CLUSTER_MODE=simulated
KUBECONFIG=

# Persistence: SQLite path locally, or PostgreSQL DSN in Cloud SQL
KUBEGUARD_SQLITE_PATH=kubeguard_sessions.db
KUBEGUARD_POSTGRES_DSN=

# Server bind & CORS allow-list (defaults to 127.0.0.1 in development/test)
KUBEGUARD_BIND_HOST=127.0.0.1
KUBEGUARD_PORT=8080
KUBEGUARD_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
